#!/usr/bin/env bash
# cmuxp: a coordinator Claude plus thread Claudes, one cmux workspace each, in the cmux app.
# Run these from a terminal inside cmux (its socket only accepts cmux's own processes by default).
#   bin/cmuxp login     sign cmuxp's Claude in (once; run /login if asked, then /exit)
#   bin/cmuxp up        start the coordinator and the dashboard
#   bin/cmuxp down      stop the daemon (workspaces stay open)
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export CMUXP_HOME="${CMUXP_HOME:-$HOME/.cmuxp-sandbox}"
export PYTHONPATH="$HERE"

case "${1:-}" in
  login)
    command -v claude >/dev/null || { echo "Claude Code is required (https://claude.com/claude-code)"; exit 1; }
    mkdir -p "$CMUXP_HOME/claude-config"
    echo "Starting cmuxp's Claude (its own config, not your ~/.claude). Finish sign-in, then type /exit."
    cd "$CMUXP_HOME" && CLAUDE_CONFIG_DIR="$CMUXP_HOME/claude-config" exec claude
    ;;
  *)
    command -v "${CMUXP_CMUX:-cmux}" >/dev/null || { echo "The cmux CLI isn't on PATH. Run this inside the cmux app, or set CMUXP_CMUX."; exit 1; }
    exec python3 -m cmuxp.cli "$@"
    ;;
esac
